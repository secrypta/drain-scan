#!/usr/bin/env bash
#
# drain-scan scanner entry point. Runs the drain-scan rule set over a target and prints one
# unified report (vector / location / severity / PoC-fixture / fix). Thin venv+solc wrapper
# around scanner/scan.py (same toolchain as validate/run.sh).
#
# Usage:
#   scan <path> [--format pretty|json] [--allow-paths <dir>] [--no-fail]
#     <path>  a .sol file or a Foundry/Hardhat project directory
#
# Requires the project venv (.venv) with solc-select; see validate/README. The analysis core
# runs our own pass over the solc AST (no Slither / crytic-compile - deliberately, this is MIT).
# Semgrep rules are run too if present and `semgrep` is installed (optional).

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV="$REPO_ROOT/.venv"
SOLC_VERSION="${SOLC_VERSION:-0.8.24}"

if [ ! -x "$VENV/bin/python3" ]; then
  echo "error: venv not found at $VENV. Create it (see validate/README.md):" >&2
  echo "  python3 -m venv $VENV && . $VENV/bin/activate && pip install -r requirements.txt" >&2
  exit 2
fi
# shellcheck disable=SC1091
. "$VENV/bin/activate"

solc-select use "$SOLC_VERSION" >/dev/null 2>&1 || {
  echo "error: solc $SOLC_VERSION not installed. Run: solc-select install $SOLC_VERSION" >&2
  exit 2
}

exec python3 "$REPO_ROOT/scanner/scan.py" "$@"
